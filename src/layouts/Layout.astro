---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MensajeApp from "../components/section/MensajeApp.astro";
import { getEntry } from "astro:content";
const data = (await getEntry("siteConfig", "site"))!.data;
import MetadataLayout from "../components/constructor/MetadataLayout.astro";
import ScriptsBodyAstroComponent from "../components/ScriptsBody.astro";
import Modalcontac from "../components/ui/Modalcontac.astro";
import MetadataAstroComponent from "../components/Metadata.astro";

const {
  title = "Accessible Travel Peru",
  description = "Agencia de viajes inclusiva líder en Perú",
  canonical = "https://accessibletravelperu.com/",
  ogImage = "/images/new2principal.webp",
  lenguaje,
  index = true,
} = Astro.props;
const slug =
  title && typeof title === "string"
    ? title.toLowerCase().replace(/[^a-z0-9]+/g, "-")
    : "post";

const canonicalUrl = `https://accessibletravelperu.com/blog/${slug}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <MetadataLayout
      title={title}
      description={description}
      image={ogImage}
      index={index}
      canonical={canonical}
      locale="en_US"
    />
    <MetadataAstroComponent />
    <meta name="theme-color" content="#ffffff" />
  </head>

  <body class="overflow-x-hidden font-poppins bg-white text-slate-800 relative">
    <Header lenguaje={lenguaje} />
    <div class="pt-14 md:pt-22 w-full h-14 md:h-22 bg-white"></div>
    <slot />

    <Footer lenguaje={lenguaje} />
    <Modalcontac lenguaje={lenguaje} />

    <MensajeApp data={data} />

    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        const observerOptions = {
          root: null,
          rootMargin: "0px",
          threshold: 0.15,
        };

        const observer = new IntersectionObserver((entries, observer) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        }, observerOptions);

        const elements = document.querySelectorAll(".animate-on-scroll");
        elements.forEach((el) => observer.observe(el));
      });
    </script>
    <ScriptsBodyAstroComponent/>

  </body>
</html>
