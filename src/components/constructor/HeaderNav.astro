---
import FlechaCorta from "../svg/FlechaCorta.astro";
import { tinaField } from "@tinacms/astro/tina-field";

const { data, menuData, currentLocale = "en", currentPath = "/", style } = Astro.props;

// Build tree from flat items with parent field
const rawItems = data?.items ?? data ?? [];
const itemMap = new Map();
const tree = [];

for (const item of rawItems) {
  const processed = {
    ...item,
    label: item.labels?.[currentLocale] ?? item.labels?.en ?? item.key,
    children: [],
  };
  itemMap.set(item.key, processed);

  if (item.parent && itemMap.has(item.parent)) {
    itemMap.get(item.parent).children.push(processed);
  } else {
    tree.push(processed);
  }
}

// Get original items for tinaField
const originalItems = menuData?.items ?? [];

function findOriginal(key: string) {
  return originalItems.find((oi) => oi.key === key);
}

function findOriginalChild(parentKey: string, childKey: string) {
  const parent = findOriginal(parentKey);
  return parent?.children?.find((oc) => oc.key === childKey);
}

const visibleTree = tree.filter(item => item.visible);

// Active state: check if currentPath starts with item href
function isActive(href: string): boolean {
  if (href === "/") return currentPath === "/" || currentPath === "";
  return currentPath.startsWith(href);
}
---

<nav
  id="nav-links"
  class={`w-full translate-x-200 md:translate-x-0 [@media(max-width:767px)]:fixed top-14 md:top-24 lg:top-0 right-0 justify-center items-center ${style} md:flex`}
>
  <ul
    id="menu-principal"
    class="flex flex-col border-b sm:border-b-0 border-gray-300 py-4 md:py-1 md:flex-row px-4 mx-auto bg-white justify-center gap-8 md:gap-2 lg:gap-8 text-sm text-gray-700"
  >
    {
      visibleTree.map((item) => {
        const original = findOriginal(item.key);
        const hasChildren = item.children.length > 0;
        const active = isActive(item.href);

        return hasChildren ? (
          <li class="nav-dropdown group relative">
            <div class="escuchar flex items-center gap-0.5">
              <a
                href={`/${currentLocale}${item.href}`}
                class={`hover:text-blue-600 transition-colors ${active ? "text-blue-600 font-semibold" : ""}`}
                title={`LinkPage ${item.href}`}
                data-tina-field={tinaField(original, `labels.${currentLocale}`)}
              >
                {item.label}
              </a>
              <button
                class="dropdown-toggle p-1 md:p-0 items-center text-gray-500 hover:text-blue-600 transition-colors"
                aria-haspopup="true"
                aria-expanded="false"
                aria-label={`Toggle ${item.label} submenu`}
              >
                <svg
                  class="dropdown-arrow w-6 h-6 transition-transform duration-200"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
            </div>

            <ul
              class="dropdown-menu md:absolute mt-0.5 left-0 md:w-50 opacity-0 invisible translate-y-1 md:translate-y-0 scale-95 md:scale-100 transition-all duration-150 ease-out bg-white shadow-lg border rounded z-10"
              role="menu"
            >
              {item.children.filter(child => child.visible).map((child) => {
                const originalChild = findOriginalChild(item.key, child.key);
                const childActive = isActive(child.href);
                return (
                  <li role="none">
                    <a
                      href={`/${currentLocale}${child.href}`}
                      class={`block px-4 py-2 transition-colors ${childActive ? "bg-blue-50 text-blue-600 font-semibold" : "hover:bg-gray-100"}`}
                      title={`LinkPage ${child.href}`}
                      role="menuitem"
                      data-tina-field={tinaField(originalChild, `labels.${currentLocale}`)}
                    >
                      {child.label}
                    </a>
                  </li>
                );
              })}
            </ul>
          </li>
        ) : (
          <li>
            <a
              href={`/${currentLocale}${item.href}`}
              class={`hover:text-blue-600 transition-colors ${active ? "text-blue-600 font-semibold" : ""}`}
              title={`LinkPage ${item.href}`}
              data-tina-field={tinaField(original, `labels.${currentLocale}`)}
            >
              {item.label}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

<script is:inline>
  function initNavDropdowns() {
    const dropdowns = document.querySelectorAll(".nav-dropdown");

    dropdowns.forEach((dropdown) => {
      const toggle = dropdown.querySelector(".dropdown-toggle");
      const menu = dropdown.querySelector(".dropdown-menu");
      const arrow = dropdown.querySelector(".dropdown-arrow");
      const link = dropdown.querySelector("a");

      if (!toggle || !menu) return;

      // Remove old listeners
      toggle.removeEventListener("click", toggle._handler);
      toggle._handler = (e) => {
        e.preventDefault();
        e.stopPropagation();
        const isOpen = !menu.classList.contains("opacity-0");
        closeAllDropdowns();
        if (!isOpen) {
          openDropdown(menu, toggle, arrow);
        }
      };
      toggle.addEventListener("click", toggle._handler);

      // Desktop: hover
      dropdown.addEventListener("mouseenter", () => {
        if (window.innerWidth >= 768) {
          openDropdown(menu, toggle, arrow);
        }
      });

      dropdown.addEventListener("mouseleave", () => {
        if (window.innerWidth >= 768) {
          closeDropdown(menu, toggle, arrow);
        }
      });

      // Link click closes dropdown
      if (link) {
        link.addEventListener("click", () => {
          closeDropdown(menu, toggle, arrow);
        });
      }
    });

    // Close on outside click
    document.removeEventListener("click", handleOutsideNavClick);
    document.addEventListener("click", handleOutsideNavClick);

    // Close on Escape
    document.removeEventListener("keydown", handleNavEscape);
    document.addEventListener("keydown", handleNavEscape);

    // Close on resize to desktop
    window.removeEventListener("resize", handleNavResize);
    window.addEventListener("resize", handleNavResize);
  }

  function openDropdown(menu, toggle, arrow) {
    menu.classList.remove("opacity-0", "invisible", "translate-y-1", "scale-95");
    menu.classList.add("opacity-100", "visible", "translate-y-0", "scale-100");
    toggle.setAttribute("aria-expanded", "true");
    if (arrow) arrow.classList.add("rotate-180");
  }

  function closeDropdown(menu, toggle, arrow) {
    menu.classList.add("opacity-0", "invisible", "translate-y-1", "scale-95");
    menu.classList.remove("opacity-100", "visible", "translate-y-0", "scale-100");
    toggle.setAttribute("aria-expanded", "false");
    if (arrow) arrow.classList.remove("rotate-180");
  }

  function closeAllDropdowns() {
    document.querySelectorAll(".nav-dropdown").forEach((dd) => {
      const menu = dd.querySelector(".dropdown-menu");
      const toggle = dd.querySelector(".dropdown-toggle");
      const arrow = dd.querySelector(".dropdown-arrow");
      if (menu && toggle) closeDropdown(menu, toggle, arrow);
    });
  }

  function handleOutsideNavClick(e) {
    if (!e.target.closest(".nav-dropdown")) {
      closeAllDropdowns();
    }
  }

  function handleNavEscape(e) {
    if (e.key === "Escape") {
      closeAllDropdowns();
    }
  }

  function handleNavResize() {
    if (window.innerWidth >= 768) {
      closeAllDropdowns();
    }
  }

  // Initialize
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initNavDropdowns);
  } else {
    initNavDropdowns();
  }

  // Re-initialize on ViewTransitions navigation
  document.addEventListener("astro:page-load", () => {
    initNavDropdowns();
  });
</script>
