---
import Layout from "../../../layouts/Layout.astro";
import { getCollection, getEntry } from "astro:content";
import PortadaStatic from "../../../components/section/PortadaStatic.astro";
import Infotravel from "../../../components/section/Infotravel.astro";
import MainContent from "../../../components/constructor/MainContent.astro";
import { getLocaleStaticPaths, getLocaleData } from "../../../utils/getLocaleData";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import { tinaField } from "@tinacms/astro/tina-field";

export const prerender = true;

export async function getStaticPaths() {
  const toursEn = await getCollection("toursGrupalesEn");
  const toursEs = await getCollection("toursGrupalesEs");
  
  const pathsEn = toursEn.map(({ data }) => ({
    params: { locale: "en", titleLink: data.titleLink },
    props: { tour: data },
  }));
  const pathsEs = toursEs.map(({ data }) => ({
    params: { locale: "es", titleLink: data.titleLink },
    props: { tour: data },
  }));
  
  return [...pathsEn, ...pathsEs];
}

const { locale } = Astro.params;
const { lang, lenguaje } = getLocaleData(locale);
const destino = Astro.props.tour;

if (!destino) {
  throw new Error(`Destino no encontrado para el título: ${destino.titleLink}`);
}

// Load shared data for Infotravel children (page context — getEntry works here)
const siteConfig = (await getEntry("siteConfig", "site"))?.data;
const galleryLogosData = (await getEntry("galleryLogos", "gallery-logos"))?.data;
const bannersData = (await getCollection("banners"))[0]?.data;
const paymentLogosData = bannersData?.paymentLogos ?? [];

const islandName = lang === "es" ? "toursGrupalesEs" : "toursGrupalesEn";
---

<Layout title={destino.title} description={destino.description} lenguaje={lenguaje} >
    <PortadaStatic url={destino.images[0].link} title={destino.images[0].alt}/>
<MainContent>
  <TinaIsland name={islandName} wrapper={{ tag: "section" }} primary params={{ relativePath: destino.titleLink + ".json" }}>
    <Infotravel lenguaje={lenguaje} data={destino} siteConfig={siteConfig} galleryLogosData={galleryLogosData} paymentLogosData={paymentLogosData}/>
  </TinaIsland>


</MainContent>

</Layout>
