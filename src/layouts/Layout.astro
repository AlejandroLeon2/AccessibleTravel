---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MensajeApp from "../components/section/MensajeApp.astro";
import { getEntry } from "astro:content";
const data = (await getEntry("siteConfig", "site"))!.data;
import MetadataLayout from "../components/constructor/MetadataLayout.astro";
import ScriptsBodyAstroComponent from "../components/ScriptsBody.astro";
import Modalcontac from "../components/ui/Modalcontac.astro";
import MetadataAstroComponent from "../components/Metadata.astro";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import { ClientRouter } from "astro:transitions";

const {
  title = "Accessible Travel Peru",
  description = "Agencia de viajes inclusiva líder en Perú",
  canonical = "https://accessibletravelperu.com/",
  ogImage = "/images/new2principal.webp",
  lenguaje,
  index = true,
} = Astro.props;
const slug =
  title && typeof title === "string"
    ? title.toLowerCase().replace(/[^a-z0-9]+/g, "-")
    : "post";

const canonicalUrl = `https://accessibletravelperu.com/blog/${slug}`;
const currentPath = Astro.url.pathname;
const locales = ['en', 'es'];
const alternateLinks = locales.map(loc => ({
  lang: loc,
  href: `https://accessibletravelperu.com/${loc}${currentPath.replace(/^\/(en|es)/, '')}`
}));
---

<!doctype html>
<html lang={Astro.currentLocale ?? "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />

    {alternateLinks.map(alt => (
      <link rel="alternate" hreflang={alt.lang} href={alt.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`https://accessibletravelperu.com/en${currentPath.replace(/^\/(en|es)/, '')}`} />

    <MetadataLayout
      title={title}
      description={description}
      image={ogImage}
      index={index}
      canonical={canonical}
      locale={Astro.currentLocale === "es" ? "es_PE" : "en_US"}
    />
    <MetadataAstroComponent />
    <meta name="theme-color" content="#ffffff" />
    <ClientRouter />
  </head>

  <body class="overflow-x-hidden font-poppins bg-white text-slate-800 relative">
    <TinaIsland name="header" wrapper={{ tag: "header" }}>
      <Header lenguaje={lenguaje} />
    </TinaIsland>
    <div class="pt-14 md:pt-22 w-full h-14 md:h-22 bg-white"></div>
    <slot />

    <TinaIsland name="footer" wrapper={{ tag: "footer" }}>
      <Footer lenguaje={lenguaje} />
    </TinaIsland>
    <Modalcontac lenguaje={lenguaje} />

    <MensajeApp data={data} />

    <script is:inline>
      function initScrollAnimations() {
        const observerOptions = {
          root: null,
          rootMargin: "0px",
          threshold: 0.15,
        };

        const observer = new IntersectionObserver((entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              obs.unobserve(entry.target);
            }
          });
        }, observerOptions);

        const elements = document.querySelectorAll(".animate-on-scroll");
        elements.forEach((el) => observer.observe(el));
      }

      // Inicializar
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initScrollAnimations);
      } else {
        initScrollAnimations();
      }

      // Re-inicializar cuando TinaCMS actualice el DOM
      const scrollObserver = new MutationObserver(() => {
        initScrollAnimations();
      });
      scrollObserver.observe(document.body, { childList: true, subtree: true });
    </script>
    <ScriptsBodyAstroComponent/>

  </body>
</html>
