---
import Layout from "../../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import PortadaStatic from "../../../components/section/PortadaStatic.astro";
import Infotravel from "../../../components/section/Infotravel.astro";
import MainContent from "../../../components/constructor/MainContent.astro";
import lenguaje from "../../../data/locales/en.json";

export const prerender = true;

export async function getStaticPaths() {
  const tours = await getCollection("toursGrupalesEn");
  return tours.map(({ data }) => ({
    params: { titleLink: data.titleLink },
    props: { tour: data },
  }));
}


// 🧩 Accede al parámetro y busca el destino en el array
const { titleLink } = Astro.params;
const tours = await getCollection("toursGrupalesEn");
const destino = tours.find((tour) => tour.data.titleLink === titleLink)?.data;

if (!destino) {
  throw new Error(`Destino no encontrado para el título: ${titleLink}`);
}
---

<Layout title={destino.title} description={destino.description} lenguaje={lenguaje} >
    <PortadaStatic url={destino.images[0].link} title={destino.images[0].alt}/>
<MainContent>
  <Infotravel lenguaje={lenguaje}  data={destino}/>


</MainContent>

</Layout>