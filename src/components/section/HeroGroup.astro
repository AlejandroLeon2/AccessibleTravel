---
const { lenguaje, es } = Astro.props;

import Times from "../constructor/Times.astro";
import { groupTours as grouptour } from "../../data/groupTours";
import travels from "../../data/peru/peru-en/travels.json";

// Función para seleccionar el tour más cercano
function getClosestTour(allTours: any[]) {
  const now = new Date();
  const availableTours = allTours.filter(
    (tour) => !tour.agotado && tour.startDate,
  );

  if (availableTours.length === 0) {
    return allTours[0] || null;
  }

  // Encontrar el tour con la fecha de inicio más cercana
  return availableTours.reduce((closest, current) => {
    const currentDiff = Math.abs(
      new Date(current.startDate).getTime() - now.getTime(),
    );
    const closestDiff = Math.abs(
      new Date(closest.startDate).getTime() - now.getTime(),
    );
    return currentDiff < closestDiff ? current : closest;
  });
}

// Combinar todos los tours y seleccionar el más cercano
const allTours = [...grouptour, ...travels];
const closestTour = getClosestTour(allTours);

// Verificar si todos los tours están agotados
const allSoldOut =
  allTours.length > 0 &&
  allTours.every((tour) => "agotado" in tour && tour.agotado === true);

// Usar el tour más cercano o el primero si no hay disponible
const selectedTour = closestTour || grouptour[0];

// Verificar si el tour seleccionado está agotado
const isSoldOut = selectedTour?.agotado === true;
---

<section class="flex flex-col gap-6 p-6 max-w-6xl mx-auto">
  <header
    class="flex md:col-span-2 flex-col md:flex-row items-start justify-center gap-4 bg-gray-100 p-4 rounded-xl shadow"
  >
    <div class="text-left gap-4 flex md:max-w-50 justify-center items-center">
      <p
        class="text-2xl border flex flex-col border-gray-200 border-b-azul-travel border-b-4 bg-white rounded-lg px-4 py-2 w-20 font-bold text-azul-travel"
      >
        {lenguaje.heroGroupDescuento}%<span class="text-md">Off</span>
      </p>
      <p class="text-sm text-gray-600 w-full min-w-30">
        {lenguaje.heroGroupDescripcion}
      </p>
    </div>

    <Times
      lenguaje={lenguaje}
      data={selectedTour}
      allSoldOut={allSoldOut}
      showSoldOut={true}
      isHero={true}
    />
  </header>
  <div class="flex flex-col lg:flex-row justify-between space-y-2">
    <iframe
      class="w-full h-[50svh] max-h-100 lg:max-w-xl rounded-2xl"
      src="https://www.youtube-nocookie.com/embed/0sX7dygdxLE?si=9IbAGsWLQyNV_Swg"
      title="YouTube video player"
      frameborder="0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      referrerpolicy="strict-origin-when-cross-origin"
      allowfullscreen></iframe>

    <div class="bg-white w-full lg:max-w-md rounded-xl p-4">
      <h3 class="text-lg font-semibold mb-4">
        {lenguaje.heroGroupIncluyeTitulo}
      </h3>
      <ul class="space-y-3">
        {
          lenguaje.includes.map((item, i) => (
            <li class="flex items-start gap-2">
              <span class="text-green-600 font-bold">✓</span>
              <span>
                <span class="font-medium">{item}</span>:
                <span class="text-gray-600 text-sm">
                  {lenguaje.detalles[i]}
                </span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
