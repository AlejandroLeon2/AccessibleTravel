---
import Layout from "../../../../layouts/Layout.astro";
import { getCollection, getEntry } from "astro:content";
import PortadaStatic from "../../../../components/section/PortadaStatic.astro";
import Infotravel from "../../../../components/section/Infotravel.astro";
import MainContent from "../../../../components/constructor/MainContent.astro";
import { getLocaleStaticPaths, getLocaleData } from "../../../../utils/getLocaleData";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import { tinaField } from "@tinacms/astro/tina-field";

export const prerender = true;

export async function getStaticPaths() {
  const toursEn = await getCollection("toursGlobalesEn");
  const toursEs = await getCollection("toursGlobalesEs");
  
  const pathsEn = toursEn.map((entry) => ({
    params: { locale: "en", titleLink: entry.id },
    props: { destino: entry.data, slug: entry.id },
  }));
  const pathsEs = toursEs.map((entry) => ({
    params: { locale: "es", titleLink: entry.id },
    props: { destino: entry.data, slug: entry.id },
  }));
  
  return [...pathsEn, ...pathsEs];
}

const { locale } = Astro.params;
const { lang, lenguaje } = getLocaleData(locale);
const destino = Astro.props.destino;
const slug = Astro.props.slug;

if (!destino) {
  throw new Error(`Destino no encontrado para el slug: ${slug}`);
}

// Load shared data for Infotravel children (page context — getEntry works here)
const siteConfig = (await getEntry("siteConfig", "site"))?.data;
const galleryLogosData = (await getEntry("galleryLogos", "gallery-logos"))?.data;
const bannersData = (await getCollection("banners"))[0]?.data;
const paymentLogosData = bannersData?.paymentLogos ?? [];
---

<Layout title={destino.title} description={destino.description} lenguaje={lenguaje}>
    <PortadaStatic url={destino.images[0].link} title={destino.images[0].alt} transitionName={`tour-${slug}`}/>
<MainContent>
  <TinaIsland name={lang === "es" ? "toursGlobalesEs" : "toursGlobalesEn"} wrapper={{ tag: "section" }} primary params={{ relativePath: slug + ".json" }}>
    <Infotravel lenguaje={lenguaje} data={destino} siteConfig={siteConfig} galleryLogosData={galleryLogosData} paymentLogosData={paymentLogosData} bannersData={bannersData}/>
  </TinaIsland>

</MainContent>

</Layout>
