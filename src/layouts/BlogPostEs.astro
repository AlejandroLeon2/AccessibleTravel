---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Modalcontac from "../components/ui/Modalcontac.astro";
import data from "../data/accessibleTravel.json";
import MensajeApp from "../components/section/MensajeApp.astro";
import "../styles/global.css";
import PortadaStatic from "../components/section/PortadaStatic.astro";
import BlogAside from "../components/ui/BlogAside.astro";
import MainContent from "../components/constructor/MainContent.astro";
import { headerMenu } from "../utils/headerSpañol";
import lenguaje from "../data/locales/es.json";
import WhatsappCta from "../components/ui/WhatsappCta.astro";
import dest from "../data/peru/peru-en/travels.json";
import MetadataLayout from "../components/constructor/MetadataLayout.astro";
import MetadataAstroComponent from "../components/Metadata.astro";
import ScriptsBodyAstroComponent from "../components/ScriptsBody.astro";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import client from "../../tina/__generated__/client";
import { requestWithMetadata } from "@tinacms/astro/data";
import { islands } from "../lib/tina/islands";
import PostBodyBlogAstroComponent from "../components/tina/PostBodyBlog.astro";
const articulos = Object.values(
  await import.meta.glob("/src/pages/es/blog/*.mdx", { eager: true }),
);
const articulo = articulos.slice(0, 3);

const destinos = dest.filter((item) => item.recomendado === true).slice(0, 3);

const {
  title,
  description,
  image,
  date,
  author,
  tags,
  imageAutor,
  bio,
  index = true,
} = Astro.props.frontmatter;

// TinaCMS integration
const relativePath = Astro.props.file.split("/").pop() || "";
const tinaData = await requestWithMetadata(
  client.queries.blogEs({ relativePath }),
);
const post = tinaData.data.blogEs;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>{title} | Accessible Travel Peru</title>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <MetadataLayout
      title={title}
      description={description}
      image={image}
      date={date}
      author={author}
      index={index}
      canonical={title
        ? `https://accessibletravelperu.com/blog/${title.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`
        : undefined}
      locale="es_PE"
    />
    <MetadataAstroComponent />
  </head>

  <body class="overflow-x-hidden font-poppins bg-white text-slate-800">
    <Header headerMenu={headerMenu} lenguaje={lenguaje} />
    <div class="pt-14 md:pt-22 w-full h-14 md:h-22"></div>
    <PortadaStatic url={data.imagenPortadaGeneral} />

    <MainContent>
      <div class="max-w-7xl mx-auto px-4 pb-8">
        <div class="flex flex-col md:flex-row w-full justify-between gap-8">
          <!-- Contenido Principal -->
          <TinaIsland
            name="blogEs"
            wrapper={islands.blogEs.wrapper}
            params={{ relativePath }}
            primary
          >
            <PostBodyBlogAstroComponent data={post} />
          </TinaIsland>

          <!-- Sidebar -->

          <BlogAside
            data={{
              title,
              description,
              image,
              date,
              author,
              tags,
              imageAutor,
              bio,
            }}
            destinos={destinos}
            news={articulo}
            lenguaje={lenguaje}
          />
        </div>
      </div>
      <WhatsappCta lenguaje={lenguaje} variant="default" />
    </MainContent>

    <Footer headerMenu={headerMenu} lenguaje={lenguaje} />
    <Modalcontac lenguaje={lenguaje} />

    <MensajeApp data={data} />

    <ScriptsBodyAstroComponent />
  </body>
</html>
