---
import StarIcon from "../../icons/StarIcon.astro";

interface Props {
  rating: string;
  label: string;
  title: string;
  description: string;
}

const { rating, label, title, description } = Astro.props;
---

<header class="space-y-4">
  <h2 class="text-3xl font-bold text-gray-900 tracking-tight">
    {title}
  </h2>
  <p class="text-gray-600 leading-relaxed text-sm md:text-base">
    {description}
  </p>

  <div class="pt-6 border-t border-gray-100 flex items-end gap-3">
    <span class="text-6xl font-black text-cyan-900">{rating}</span>
    <div class="pb-2">
      <div class="flex text-amber-500 mb-1">
        {
          [1, 2, 3, 4, 5].map(() => (
            <StarIcon class="w-5 h-5" />
          ))
        }
      </div>
      <p class="text-xs font-bold text-gray-500 uppercase tracking-widest">
        {label}
      </p>
    </div>
  </div>
</header>
