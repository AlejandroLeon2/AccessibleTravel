---
import { getCollection } from "astro:content";
const { paymentLogosData: paymentLogosDataProp, style = "grid grid-cols-4 px-4 py-4 gap-6", base } = Astro.props;

// Fallback: load banners if not passed as prop (page context)
let paymentLogosData = paymentLogosDataProp;
if (!paymentLogosData) {
  try { paymentLogosData = (await getCollection("banners"))[0]?.data?.paymentLogos ?? []; } catch { paymentLogosData = []; }
}
const paymentLogos = paymentLogosData ?? [];
---

<section class=` py-6 bg-white ${base} `>
  <div class=`${style}    place-items-center `>
    {
      paymentLogos.map((img) => (
        <img
          src={img.src}
          alt={img.alt.en}
          title={img.titleLink}
          class="w-full xl:w-30 h-auto  object-cover group-hover:opacity-90 transition"
          loading="lazy"
          decoding="async"
        />
      ))
    }
  </div>
</section>
