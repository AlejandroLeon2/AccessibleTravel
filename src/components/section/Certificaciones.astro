---
import { getEntry } from "astro:content";
import { tinaField } from "@tinacms/astro/tina-field";
const { galleryLogosData: galleryLogosDataProp, bandera, base, style } = Astro.props;

// Fallback: load galleryLogos if not passed as prop (page context)
let galleryLogosData = galleryLogosDataProp;
if (!galleryLogosData) {
  try { galleryLogosData = (await getEntry("galleryLogos", "gallery-logos"))?.data; } catch { galleryLogosData = {}; }
}
const images = galleryLogosData?.galleryLogos ?? [];

// Definir columnas dinámicas según cantidad de imágenes
let defaultCols = "grid-cols-3"; // valor base
if (images.length <= 2) {
  defaultCols = "grid-cols-2";
} else if (images.length <= 4) {
  defaultCols = "grid-cols-4";
  } else if (images.length <= 6) {
  defaultCols = "grid-cols-5";

} else if (images.length <= 6) {
  defaultCols = "grid-cols-6";
} else {
  defaultCols = "grid-cols-7"; // fallback
}

const styles = `grid ${defaultCols} px-4 py-4 gap-6`;
---

<section class={` py-6 bg-white ${base} `}>
  <div class={`${styles}  ${style}    place-items-center `}>
    {
      images.map((img, index) => (
        <img
          src={img.src}
          alt={img.alt}
          title={img.alt}
          class={`w-full xl:w-30 h-auto ${bandera ? "max-w-35" : ""}  hover:scale-105 duration-300 filter grayscale hover:filter-none object-cover group-hover:opacity-90 transition`}
          loading="lazy"
          decoding="async"
          data-tina-field={tinaField(galleryLogosData, `galleryLogos.${index}.src`)}
        />
      ))
    }
  </div>
</section>
