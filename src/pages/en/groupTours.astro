---
import Layout from "../../layouts/Layout.astro";
import PortadaStatic from "../../components/section/PortadaStatic.astro";
import HeroGroup from "../../components/section/HeroGroup.astro";
import MainContent from "../../components/constructor/MainContent.astro";
import { getCollection, getEntry } from "astro:content";
import { getMenuPageData } from "../../utils/getMenuPageData";
const _menuData = (await getEntry("headerMenu", "menu"))!.data;
const { labels, coverImage } = getMenuPageData(_menuData.items, "GroupTours");
const _pageLabel = labels.en; // o labels.es según idioma activo

import CardDestino from "../../components/ui/CardDestino.astro";
import Times from "../../components/constructor/Times.astro";
import Certificaciones from "../../components/section/Certificaciones.astro";
import lenguaje from "../../data/locales/en.json";

const groupTours = (await getCollection("toursGrupalesEn")).map(({ data }) => ({
  ...data,
  startDate: new Date(data.startDate),
  endDate: new Date(data.endDate),
}));
---

<Layout
  title={lenguaje.title}
  description={lenguaje.description}
  lenguaje={lenguaje}
>
  <PortadaStatic
    url={coverImage}
    texto={_pageLabel}
  />
  <MainContent>
    <HeroGroup lenguaje={lenguaje} groupTours={groupTours} />
    <section class="flex flex-col px-4 py-8 gap-4 w-full max-w-5xl mx-auto">
      {
        groupTours.map((lugar) => (
          <div class="flex flex-col-reverse justify-between w-full max-w-3xl  mx-auto gap-4">
            <CardDestino
              lenguaje={lenguaje}
              data={lugar}
              bandera="max-w-xs"
              botones="justify-between md:flex-col md:justify-around"
              style="flex flex-col md:flex-row w-full max-w-xs md:max-w-4xl  mx-auto"
              ruta="/group/"
            />
            <div class="flex justify-center max-w-xs w-full md:max-w-3xl mx-auto  border border-gray-100 shadow px-4 py-2 rounded-xl">
              <Times lenguaje={lenguaje} data={lugar} showSoldOut={true} />
            </div>
          </div>
        ))
      }
    </section>
    <Certificaciones />
  </MainContent>
</Layout>
