---
import { getEntry } from "astro:content";
const galleryData = (await getEntry("galleryLogos", "gallery-logos"))!.data;
const images = galleryData.galleryLogos;

const {
  style = "grid grid-cols-5 px-4 py-4 gap-6 ",
  bandera,
  base,
} = Astro.props;
---

<section class={` py-6 bg-white ${base} `}>
  <div class={`${style}    place-items-center `}>
    {
      images.map((img) => (
        <img
          src={img.src}
          alt={img.alt}
          title={img.alt}
          class={`w-full xl:w-30 h-auto ${bandera ? "max-w-35" : ""}  hover:scale-105 duration-300 filter grayscale hover:filter-none object-cover group-hover:opacity-90 transition`}
          loading="lazy"
          decoding="async"
        />
      ))
    }
  </div>
</section>

