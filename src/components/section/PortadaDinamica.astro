---
// @ts-nocheck
import FlechaCorta from "../svg/FlechaCorta.astro";
import { tinaField } from "@tinacms/astro/tina-field";

interface Props {
  banners?: any[];
  bannersData?: any;
}

const { banners: bannersProp, bannersData } = Astro.props;

// Process bannersData into banners array if not provided directly
const banners = bannersProp ?? bannersData?.banners?.map((b) => ({
  src: b.src,
  alt: b.alt?.es ?? b.alt?.en ?? '',
  title: b.title?.es ?? b.title?.en ?? '',
})) ?? [];
---

<slider-portada class="block bg-white relative mx-auto w-full h-[50svh] sm:h-[60svh] md:h-[70svh] min-h-100 max-h-150 overflow-hidden group">
  <button
    id="prev-btn"
    class="absolute active:scale-95 hover:scale-105 duration-300 left-1 top-1/2 -translate-y-1/2 z-20 bg-white/30 rounded-full p-2 shadow hover:bg-white active:bg-white transition"
    aria-label="Previous banner"
  >
    <FlechaCorta style="rotate-90"/>
  </button>

  <div class="relative w-full h-full" id="slider-container">
    {banners.map((banner, index) => (
      <div 
        class={`banner-slide absolute inset-0 transition-opacity duration-700 ease-in-out ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
        data-index={index}
      >
        <div class="absolute inset-0 flex justify-start items-center bg-black/20 px-12 z-10">
          <h1 
            class="max-w-xs  sm:max-w-sm text-4xl sm:text-5xl transition-all duration-500 md:text-5xl lg:text-6xl lg:max-w-xl font-bold text-white "
            data-tina-field={bannersData?.banners?.[index] ? tinaField(bannersData.banners[index], 'title') : undefined}
          >
            {banner.title}
          </h1>
        </div>
        <img
          src={banner.src}
          alt={banner.alt}
          class="w-full h-full object-cover"
          loading={index === 0 ? "eager" : "lazy"}
          fetchpriority={index === 0 ? "high" : "auto"}
          data-tina-field={bannersData?.banners?.[index] ? tinaField(bannersData.banners[index], 'src') : undefined}
        />
      </div>
    ))}
  </div>

  <button
    id="next-btn"
    class="absolute active:scale-95 hover:scale-105 duration-300 right-2 top-1/2 -translate-y-1/2 z-20 bg-white/30 text-center rounded-full p-2 shadow hover:bg-white active:bg-white transition"
    aria-label="Next banner"
  >
    <FlechaCorta style="-rotate-90"/>
  </button>
</slider-portada>

<script>
  function initSlider(container) {
    // Clear any existing interval to prevent stacking
    if (container._sliderInterval) {
      clearInterval(container._sliderInterval);
    }

    // Remove old listeners by cloning
    const prevBtn = container.querySelector('#prev-btn');
    const nextBtn = container.querySelector('#next-btn');
    if (!prevBtn || !nextBtn) return;

    const newPrev = prevBtn.cloneNode(true);
    const newNext = nextBtn.cloneNode(true);
    prevBtn.parentNode.replaceChild(newPrev, prevBtn);
    nextBtn.parentNode.replaceChild(newNext, nextBtn);

    let index = 0;
    const slides = container.querySelectorAll('.banner-slide');
    const totalSlides = slides.length;

    if (totalSlides <= 1) return;

    const updateActiveSlide = (newIndex) => {
      slides[index].classList.remove('opacity-100', 'z-10');
      slides[index].classList.add('opacity-0', 'z-0');
      
      index = newIndex;
      
      slides[index].classList.remove('opacity-0', 'z-0');
      slides[index].classList.add('opacity-100', 'z-10');
    };

    newPrev.addEventListener("click", () => {
      const newIndex = (index - 1 + totalSlides) % totalSlides;
      updateActiveSlide(newIndex);
    });

    newNext.addEventListener("click", () => {
      const newIndex = (index + 1) % totalSlides;
      updateActiveSlide(newIndex);
    });

    container._sliderInterval = setInterval(() => {
      const newIndex = (index + 1) % totalSlides;
      updateActiveSlide(newIndex);
    }, 10000);
  }

  // Initial load
  document.querySelectorAll('slider-portada').forEach(el => initSlider(el));

  // MutationObserver for TinaCMS updates
  const observer = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      if (mutation.type === 'childList') {
        mutation.addedNodes.forEach((node) => {
          if (node.nodeType === 1) {
            if (node.matches?.('slider-portada')) {
              initSlider(node);
            }
            node.querySelectorAll?.('slider-portada').forEach(el => initSlider(el));
          }
        });
      }
    });
  });

  observer.observe(document.body, { childList: true, subtree: true });
</script>
