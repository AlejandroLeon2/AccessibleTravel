---
import Layout from "../../layouts/Layout.astro";
import PortadaDinamica from "../../components/section/PortadaDinamica.astro";
import Certificaciones from "../../components/section/Certificaciones.astro";
import Comentarios from "../../components/section/Comentarios.astro";
import Actividades from "../../components/section/Actividades.astro";
import MainContent from "../../components/constructor/MainContent.astro";
import { getCollection } from "astro:content";
import BlogNew from "../../components/section/BlogNew.astro";
import DestinosRecomendados from "../../components/section/DestinosRecomendados.astro";
import HeroHome from "../../components/section/HeroHome.astro";
import WhatsappCta from "../../components/ui/WhatsappCta.astro";
import { getLocaleStaticPaths, getLocaleData, getTourCollectionName } from "../../utils/getLocaleData";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import { getConfig } from "../../lib/tina/data";

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.params;
const { lang, lenguaje } = getLocaleData(locale);

// Tours recomendados (colección dinámica según locale)
const tourCollection = getTourCollectionName(locale, "global");
const data = (await getCollection(tourCollection)).map((entry) => ({ ...entry.data, slug: entry.id }));
const destinos = data.filter((item) => item.recomendado === true).slice(0, 4);

// Blog posts (colección dinámica según locale)
const blogCollection = lang === "es" ? "blogEs" : "blogEn";
const articulos = (await getCollection(blogCollection))
  .sort((a, b) => new Date(b.data.date ?? 0).getTime() - new Date(a.data.date ?? 0).getTime())
  .slice(0, 3)
  .map((post) => ({
    url: `/${lang}/blog/${post.id}`,
    frontmatter: {
      title: post.data.title,
      image: post.data.image,
      author: post.data.author,
      date: post.data.date,
    },
  }));

// Banners (dinámicos según locale)
const bannersData = (await getCollection("banners"))[0]?.data;
const banners = bannersData?.banners.map((b) => ({
  src: b.src,
  alt: b.alt[lang] ?? b.alt.en,
  title: b.title[lang] ?? b.title.en,
})) ?? [];
---

<Layout
  title={lenguaje.title}
  description={lenguaje.description}
  lenguaje={lenguaje}
>
  <TinaIsland name="banners" wrapper={{ tag: "div" }}>
    <PortadaDinamica banners={banners} />
  </TinaIsland>

  <MainContent>
       <div class="overflow-hidden">
    <div class="animate-on-scroll fade-up">
      <TinaIsland name="heroHome" wrapper={{ tag: "section" }} primary>
        <HeroHome lenguaje={lenguaje} />
      </TinaIsland>
    </div>

    <div class="animate-on-scroll fade-up delay-100">
      <Actividades lenguaje={lenguaje} />
    </div>

    <div class="animate-on-scroll fade-up delay-200">
      <DestinosRecomendados lenguaje={lenguaje} {destinos} />
    </div>

    <h2
      class="text-4xl mx-auto max-w-5xl mt-8 px-4 font-semibold text-gray-900 animate-on-scroll fade-left"
    >
      {lenguaje.tituloMiembros}
    </h2>

    <div class="animate-on-scroll fade-up delay-100">
      <Certificaciones bandera={true} />
    </div>

    <div class="animate-on-scroll fade-up delay-200">
      <Comentarios lenguaje={lenguaje} />
    </div>

    <div class="animate-on-scroll fade-up delay-300">
      <BlogNew
        articulo={articulos}
        lenguaje={lenguaje}
        home="s"
        grid="grid grid-col-1 md:grid-cols-2"
      />
    </div>
    <div class="animate-on-scroll fade-up delay-300">
      <WhatsappCta lenguaje={lenguaje} variant="booking" />
    </div>
    </div>
  </MainContent>
</Layout>
