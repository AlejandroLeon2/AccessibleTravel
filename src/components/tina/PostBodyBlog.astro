---
// @ts-nocheck
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import type { BlogEnQuery } from '../../../tina/__generated__/types';
import { markdownBody } from '../../scripts/markdown-styles';

interface Props {
  data?: BlogEnQuery['blogEs'] | null;
}
const { data } = Astro.props;
---
{
  data && (
    <article class="flex flex-col w-full   max-w-4xl py-12 mx-auto">
      <!-- Hero Image -->
      <figure class="mb-12 ">
        <img
          src={data.image ?? "/images/gato.jpg"}
          alt={`Imagen destacada de ${data.title}`}
          class="w-full  aspect-video object-cover rounded-lg"
          data-tina-field={tinaField(data, 'image')}
        />
      </figure>

      <!-- Header del Post -->
      <header class="mb-12 pb-8  border-b border-gray-200">
        <h1 class="text-4xl lg:text-5xl font-light text-gray-900 mb-6 leading-tight" data-tina-field={tinaField(data, 'title')}>
          {data.title}
        </h1>

        <div class="flex flex-wrap items-center gap-4 text-sm text-gray-500">
          <time datetime={data.date} class="flex items-center gap-2" data-tina-field={tinaField(data, 'date')}>
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
              ></path>
            </svg>
            {
              data.date ? new Date(data.date).toLocaleDateString("es-PE", {
                year: "numeric",
                month: "long",
                day: "numeric",
              }) : ""
            }
          </time>

          <span class="flex items-center gap-2" data-tina-field={tinaField(data, 'author')}>
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
              ></path>
            </svg>
            {data.author}
          </span>
        </div>

        {
          data.description && (
            <p class="text-lg text-gray-600 mt-6 leading-relaxed" data-tina-field={tinaField(data, 'description')}>
              {data.description}
            </p>
          )
        }
      </header>

<div class={markdownBody} data-tina-field={tinaField(data, 'body')}>
  <TinaMarkdown content={data.body} />
</div>
    </article>
  )
}
