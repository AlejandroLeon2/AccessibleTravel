---
import InsightStats from "./recomendacion/InsightStats.astro";
import ProgressItem from "./recomendacion/ProgressItem.astro";
import StarPicker from "./recomendacion/StarPicker.astro";
import CheckIcon from "../icons/CheckIcon.astro";

/**
 * FORM_CONFIG: Centralized configuration for the Google Form integration.
 * Following SOLID: Open/Closed Principle - adding new fields only requires updating this object.
 */
const FORM_CONFIG = {
    actionUrl:
        "https://docs.google.com/forms/u/0/d/e/1FAIpQLSfrN6RkSFsLT2SWI4-EsX7kOAxVvopctOShMiaCWMIzPZWs-Q/formResponse",
    fields: {
        fullName: "entry.138782949",
        email: "entry.1821882549",
        message: "entry.73294339",
        tourTitle: "entry.1166154914",
    },
    scores: [
        { label: "Rating", value: 85, entryId: "entry.434545413" },
        { label: "Comfort", value: 90, entryId: "entry.547706226" },
        { label: "Food", value: 75, entryId: "entry.1643821012" },
        { label: "Hospitality", value: 95, entryId: "entry.1821846692" },
        { label: "Hygiene", value: 80, entryId: "entry.917533887" },
        { label: "Reception", value: 88, entryId: "entry.1907204803" },
    ],
};

const STATS_CONTENT = {
    rating: "4.8",
    label: "Excellent Choice",
    title: "Traveler Insights",
    description:
        "We take every piece of feedback seriously. Here is a breakdown of how our community perceives our services across key categories.",
};
---

<article
    class="flex flex-col h-full gap-12 lg:flex-row mb-8 px-6 xl:max-w-7xl w-full mx-auto justify-between"
>
    <!-- Experience Stats Section -->
    <section
        class="sticky top-6 flex hidden flex-col w-full lg:max-w-sm gap-12 items-start"
        aria-labelledby="insights-title"
    >
        <InsightStats
            id="insights-title"
            title={STATS_CONTENT.title}
            description={STATS_CONTENT.description}
            rating={STATS_CONTENT.rating}
            label={STATS_CONTENT.label}
        />

        <!-- Progress Bars (Dumb Components) -->
        <div
            class="grid grid-cols-2 pb-12 md:pb-0 lg:flex w-full lg:flex-col gap-x-12 gap-y-6"
            role="img"
            aria-label="Statistics grid"
        >
            {
                FORM_CONFIG.scores.map(({ label, value }) => (
                    <ProgressItem label={label} value={value} />
                ))
            }
        </div>
    </section>

    <!-- Review Form Container (Smart Wrapper) -->
    <section
        class="relative bg-azul-travel rounded-sm p-8 md:p-12 overflow-hidden"
        aria-labelledby="form-title"
    >
        <!-- Success Panel: Displayed after successful submission -->
        <div
            id="success-panel"
            class="hidden flex mx-auto flex-col w-full items-center justify-center text-center py-12 space-y-6 animate-in fade-in zoom-in duration-500"
            role="alert"
        >
            <div
                class="w-20 h-20 bg-cyan-900 rounded-full flex items-center justify-center shadow-lg"
            >
                <CheckIcon class="h-10 w-10 text-white" />
            </div>
            <div class="text-cyan-950">
                <h3 class="text-3xl font-bold mb-2">Thank You!</h3>
                <p class="max-w-sm font-medium">
                    Your feedback has been submitted directly to our quality
                    team. We appreciate your time!
                </p>
            </div>
            <button
                onclick="window.location.reload()"
                class="bg-cyan-900 hover:bg-cyan-800 text-white px-8 py-3 rounded-xl font-bold transition-all shadow-md active:scale-95"
            >
                Send Another Review
            </button>
        </div>

        <!-- Form Panel -->
        <div id="form-panel">
            <header class="mb-10 text-center md:text-left">
                <h3
                    id="form-title"
                    class="text-3xl font-bold text-cyan-950 mb-3"
                >
                    Share Your Journey
                </h3>
                <p class="text-cyan-900 font-medium max-w-xl">
                    Help us maintain our standards and inspire others. Every
                    review is sent directly to our management team for review.
                </p>
            </header>

            <form
                id="google-review-form"
                class="space-y-8"
                data-action={FORM_CONFIG.actionUrl}
                data-entry-titulo={FORM_CONFIG.fields.tourTitle}
            >
                <!-- Ratings Grid (StarPicker components) -->
                <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
                    {
                        FORM_CONFIG.scores.map((score) => (
                            <StarPicker
                                label={score.label}
                                entryId={score.entryId}
                            />
                        ))
                    }
                </div>

                <!-- Contact Information -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <input
                        type="text"
                        name={FORM_CONFIG.fields.fullName}
                        placeholder="Your Full Name*"
                        required
                        aria-label="Full Name"
                        class="w-full p-4 rounded-sm bg-white/60 border border-cyan-900/20 text-cyan-950 placeholder:text-cyan-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-cyan-900 transition-all font-medium"
                    />
                    <input
                        type="email"
                        name={FORM_CONFIG.fields.email}
                        placeholder="Your Email Address*"
                        required
                        aria-label="Email Address"
                        class="w-full p-4 rounded-sm bg-white/60 border border-cyan-900/20 text-cyan-950 placeholder:text-cyan-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-cyan-900 transition-all font-medium"
                    />
                </div>

                <!-- Feedback Message -->
                <textarea
                    name={FORM_CONFIG.fields.message}
                    rows="5"
                    required
                    placeholder="Tell us about the highlights of your trip..."
                    aria-label="Your Feedback"
                    class="w-full p-4 rounded-sm bg-white/60 border border-cyan-900/20 text-cyan-950 placeholder:text-cyan-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-cyan-900 transition-all resize-none font-medium"
                ></textarea>

                <!-- Form Footer/Action -->
                <footer
                    class="flex flex-col md:flex-row items-center justify-between gap-6"
                >
                    <p
                        class="text-xs text-cyan-950/70 font-bold max-w-sm text-center md:text-left"
                    >
                        By submitting, you agree that your feedback may be
                        displayed anonymously on our website to help other
                        travelers.
                    </p>
                    <button
                        id="submit-btn"
                        type="submit"
                        class="w-full md:w-auto cursor-pointer duration-300 px-12 py-4 bg-cyan-950 text-white rounded-sm font-black uppercase tracking-widest hover:bg-white hover:text-cyan-950 active:bg-cyan-950 active:text-white hover:scale-105 active:scale-95 transition-all shadow-xl shadow-cyan-900/30"
                    >
                        Send Review
                    </button>
                </footer>
            </form>
        </div>
    </section>
</article>

<script is:inline>
    (function () {
        const form = document.querySelector("#google-review-form");
        const submitBtn = document.querySelector("#submit-btn");
        const formPanel = document.querySelector("#form-panel");
        const successPanel = document.querySelector("#success-panel");

        if (!form) return;

        form.addEventListener("submit", async (e) => {
            e.preventDefault();

            const actionUrl = form.dataset.action;

            // Update UI state
            submitBtn.disabled = true;
            const originalText = submitBtn.textContent;
            submitBtn.textContent = "Sending...";
            submitBtn.classList.add("opacity-50", "cursor-not-allowed");

            const formData = new FormData(form);

            // Capturar el valor dinamico del titulo y adjuntarlo si existe
            const tituloEl = document.querySelector("#titulo");
            const entryTitulo = form.dataset.entryTitulo;
            if (tituloEl && tituloEl.dataset.titulo && entryTitulo) {
                formData.append(entryTitulo, tituloEl.dataset.titulo);
            }

            try {
                // Google Forms requires no-cors mode for cross-origin submission without a proper API
                await fetch(actionUrl, {
                    method: "POST",
                    mode: "no-cors",
                    body: formData,
                });

                // Show success state
                formPanel.classList.add("hidden");
                successPanel.classList.remove("hidden");
                successPanel.scrollIntoView({
                    behavior: "smooth",
                    block: "center",
                });
            } catch (error) {
                console.error("Submission error:", error);
                alert(
                    "There was an error sending your review. Please try again or contact us directly.",
                );

                // Reset UI state
                submitBtn.disabled = false;
                submitBtn.textContent = originalText;
                submitBtn.classList.remove("opacity-50", "cursor-not-allowed");
            }
        });
    })();
</script>
