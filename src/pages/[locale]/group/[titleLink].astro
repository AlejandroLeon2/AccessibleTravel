---
import Layout from "../../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import PortadaStatic from "../../../components/section/PortadaStatic.astro";
import Infotravel from "../../../components/section/Infotravel.astro";
import MainContent from "../../../components/constructor/MainContent.astro";
import { getLocaleStaticPaths, getLocaleData } from "../../../utils/getLocaleData";

export const prerender = true;

export async function getStaticPaths() {
  const toursEn = await getCollection("toursGrupalesEn");
  const toursEs = await getCollection("toursGrupalesEs");
  
  const pathsEn = toursEn.map(({ data }) => ({
    params: { locale: "en", titleLink: data.titleLink },
    props: { tour: data },
  }));
  const pathsEs = toursEs.map(({ data }) => ({
    params: { locale: "es", titleLink: data.titleLink },
    props: { tour: data },
  }));
  
  return [...pathsEn, ...pathsEs];
}

const { locale } = Astro.params;
const { lang, lenguaje } = getLocaleData(locale);
const destino = Astro.props.tour;

if (!destino) {
  throw new Error(`Destino no encontrado para el título: ${destino.titleLink}`);
}
---

<Layout title={destino.title} description={destino.description} lenguaje={lenguaje} >
    <PortadaStatic url={destino.images[0].link} title={destino.images[0].alt}/>
<MainContent>
  <Infotravel lenguaje={lenguaje}  data={destino}/>


</MainContent>

</Layout>
