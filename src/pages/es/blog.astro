---
// src/pages/blog.astro
import Layout from '../../layouts/Layout.astro'
import PostCard from '../../components/ui/PostCard.astro'
import MainContent from '../../components/constructor/MainContent.astro'
import PortadaStatic from '../../components/section/PortadaStatic.astro'
import BlogAside from '../../components/ui/BlogAside.astro'
import lenguaje from "../../data/locales/es.json";
import { getCollection, getEntry } from "astro:content";
import { getMenuPageData } from "../../utils/getMenuPageData";
const _menuData = (await getEntry("headerMenu", "menu"))!.data;
const { label: _pageLabel, coverImage: _coverImage } = getMenuPageData(_menuData.items, "Blog");


const dest = (await getCollection("toursGlobalesEs")).map(({ data }) => data);
const destinos = dest.filter((item) => item.recomendado === true).slice(0, 3);



const articulo = Object.values(await import.meta.glob('./blog/*.mdx', { eager: true }))

---

<Layout title={lenguaje.title} description={lenguaje.description} lenguaje={lenguaje} title="Blog Retro">
  <PortadaStatic url={_coverImage} texto={_pageLabel} />
  <MainContent>
<section class="flex flex-col mx-auto md:flex-row gap-4 px-4 w-full justify-center max-w-7xl">
    <section class="flex flex-col py-4 md:py-12 gap-4 w-full mx-auto md:mx-0 max-w-2xl">
      {articulo.map(posts => (

          <PostCard post={posts} />

      ))}
    </section>
    <BlogAside lenguaje={lenguaje}  news={articulo} destinos={destinos}/>
</section>

  </MainContent>

</Layout>


