---

const { lenguaje } = Astro.props;
---

<section class="w-full max-w-7xl mx-auto mb-12">
  <div class="flex flex-col gap-8 ">
    <div class="pb-4 px-6 md:px-0">
      <h2 class="text-3xl font-bold text-gray-900 tracking-tight">
        {lenguaje.reviewList.title}
      </h2>
      <p class="text-gray-600 mt-2">
        {lenguaje.reviewList.description}
      </p>
    </div>

    <!-- Review Container — CSS columns masonry -->
    <div
      id="dynamic-reviews-container"
      class="mosaico px-6 md:px-0"
      data-empty={lenguaje.reviewList.empty}
      data-error={lenguaje.reviewList.error}
      data-verified={lenguaje.reviewList.verified}
      data-anonymous={lenguaje.reviewList.anonymous}
    >
      <!-- Loading Skeleton -->
      <div
        id="review-loading"
        class="py-12 text-center"
        style="column-span: all;"
      >
        <div
          class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-azul-travel"
        >
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .mosaico {
    columns: 280px;
    column-gap: 1.5rem;
  }

  .mosaico > :global(.card) {
    break-inside: avoid;
    margin-bottom: 1.5rem;
    display: block;
  }
</style>

<script is:inline>
  async function loadReviews() {
    const container = document.getElementById("dynamic-reviews-container");
    const loading = document.getElementById("review-loading");
    const tituloEl = document.querySelector("#titulo");

    const API_URL =
      "https://script.google.com/macros/s/AKfycbwKsMg1OltMMK4prGlYVDjBY4LJaeiQVkubKeJKvRisokn6GGMx14ORu3Tkeu3poYOy0Q/exec";
    if (!tituloEl || !tituloEl.dataset.titulo) {
      if (loading) loading.style.display = "none";
      return;
    }

    const currentTourTitle = tituloEl.dataset.titulo.trim();

    try {
      const response = await fetch(API_URL);
      if (!response.ok) throw new Error("Failed to fetch reviews");

      const data = await response.json();

      // Filter reviews that match the tour slug exactly
      const matchingReviews = (data.reviews || []).filter(
        (review) =>
          review.tourTitle &&
          review.tourTitle.trim() === currentTourTitle,
      );

      // Hide loading
      if (loading) loading.style.display = "none";

      if (matchingReviews.length === 0) {
        container.innerHTML = `
          <div class="break-inside-avoid py-10 text-center" style="column-span: all;">
            <p class="text-gray-500 italic">${container.dataset.empty}</p>
          </div>
        `;
        return;
      }

      // Generate SVG stars
      const generateStars = (rating) => {
        let starsHtml = "";
        for (let i = 1; i <= 5; i++) {
          const fillClass = i <= rating ? "text-amber-400" : "text-gray-200";
          starsHtml += `
            <svg class="w-5 h-5 ${fillClass}" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.518 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.975 2.89a1 1 0 00-.364 1.118l1.518 4.674c.3.921-.755 1.688-1.538 1.118L10 15.347l-3.975 2.89c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.364-1.118L1.666 10.1c-.783-.57-.38-1.81.588-1.81h4.915a1 1 0 00.95-.69l1.518-4.674z" />
            </svg>
          `;
        }
        return starsHtml;
      };

      // Create cards format safely with textContent approach within string templates
      // Note: In real production, avoid innerHTML over raw input if not fully trusted,
      // but here we know the fields come from the form mapping.
      const escapeHTML = (str) => {
        return (str || "").replace(
          /[&<>'"]/g,
          (tag) =>
            ({
              "&": "&amp;",
              "<": "&lt;",
              ">": "&gt;",
              "'": "&#39;",
              '"': "&quot;",
            })[tag] || tag,
        );
      };

      const cardsHtml = matchingReviews
        .map((review) => {
          const dateObj = new Date(review.timestamp);
          const formattedDate = isNaN(dateObj)
            ? ""
            : dateObj.toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              });

          const ratingNum = parseInt(review.rating, 10);
          const rating = isNaN(ratingNum) ? 5 : ratingNum;

          const nameText = escapeHTML(review.fullName || container.dataset.anonymous);
          const messageText = escapeHTML(review.message || "");

          return `
          <article class="card bg-white p-4 rounded-sm shadow-xl shadow-gray-200/50 border border-gray-100 flex flex-col justify-between transition-all duration-300 hover:shadow-2xl hover:shadow-cyan-900/10 hover:-translate-y-1">
            <div class="space-y-2">
              <div class="flex flex-col  sm:justify-start ">
                <div class="flex items-center gap-1 group">
                  ${generateStars(rating)}
                </div>
               
              </div>
              <p class="text-gray-700 leading-relaxed font-medium">"${messageText}"</p>
            </div>
            
            <div class="mt-4 pt-4 border-t border-gray-100 flex items-center gap-3">
              <div class="w-10 h-10 bg-azul-travel rounded-full flex items-center justify-center text-white font-bold text-sm shadow-md">
                ${nameText.charAt(0).toUpperCase()}
              </div>
              <div>
                <p class="font-bold text-gray-900">${nameText}</p>
                <div class="flex items-center gap-1 text-emerald-500 text-xs font-semibold mt-0.5">
 <span class="text-xs font-semibold text-gray-400 tracking-wider uppercase">${formattedDate}</span>
                </div>
              </div>
            </div>
          </article>
        `;
        })
        .join("");

      container.innerHTML = cardsHtml;
    } catch (error) {
      console.error("Error fetching reviews:", error);
      if (loading) loading.style.display = "none";
      container.innerHTML = `
        <div class="break-inside-avoid py-10 text-center" style="column-span: all;">
          <p class="text-red-500">${container.dataset.error}</p>
        </div>
      `;
    }
  }

  // Inicializar
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", loadReviews);
  } else {
    loadReviews();
  }

  // Re-inicializar en cada navegación de ViewTransitions
  document.addEventListener("astro:page-load", () => {
    loadReviews();
  });
</script>
