---
import Layout from "../../layouts/Layout.astro";
import MainContent from "../../components/constructor/MainContent.astro";
import PortadaStatic from "../../components/section/PortadaStatic.astro";
import Certificaciones from "../../components/section/Certificaciones.astro";
import HeroAbout from "../../components/section/HeroAbout.astro";
import ExperienciaAbout from "../../components/section/ExprerienciaAbout.astro";
import WhatsappCta from "../../components/ui/WhatsappCta.astro";
import { getEntry } from "astro:content";
import { getLocaleStaticPaths, getLocaleData, getPageCoverData } from "../../utils/getLocaleData";

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.params;
const { lang, lenguaje } = getLocaleData(locale);

const _menuData = (await getEntry("headerMenu", "menu"))!.data;
const { pageLabel: _pageLabel, coverImage: _coverImage } = getPageCoverData(_menuData.items, "AboutUs", lang);
---

<Layout
  title={lenguaje.title}
  description={lenguaje.description}
  lenguaje={lenguaje}
>
  <PortadaStatic
    url={_coverImage}
    texto={_pageLabel}
  />

  <MainContent>
    <HeroAbout lenguaje={lenguaje} />
    <WhatsappCta lenguaje={lenguaje} variant="default" />
    <Certificaciones />
    <ExperienciaAbout lenguaje={lenguaje} />
  </MainContent>
</Layout>
