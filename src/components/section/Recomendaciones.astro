---
import InsightStats from "./recomendacion/InsightStats.astro";
import ProgressItem from "./recomendacion/ProgressItem.astro";
import StarPicker from "./recomendacion/StarPicker.astro";
import CheckIcon from "../icons/CheckIcon.astro";

const { lenguaje } = Astro.props;

/**
 * FORM_CONFIG: Centralized configuration for the Google Form integration.
 * Following SOLID: Open/Closed Principle - adding new fields only requires updating this object.
 */
const FORM_CONFIG = {
  actionUrl:
    "https://docs.google.com/forms/d/e/1FAIpQLScW1VahsHSCWY2sAjGlow8KgSzObVMJq5OkGAfT32ekPVerCw/formResponse",
  fields: {
    fullName: "entry.1770894358",
    email: "entry.228567320",
    message: "entry.1360316101",
    tourTitle: "entry.1704160591",
  },
  scores: [
    { label: lenguaje.reviewForm.rating, value: 85, entryId: "entry.956031060" },
    { label: lenguaje.reviewForm.comfort, value: 90, entryId: "entry.1766596268" },
    { label: lenguaje.reviewForm.food, value: 75, entryId: "entry.250609652" },
    { label: lenguaje.reviewForm.hospitality, value: 95, entryId: "entry.395815328" },
    { label: lenguaje.reviewForm.hygiene, value: 80, entryId: "entry.956551446" },
    { label: lenguaje.reviewForm.reception, value: 88, entryId: "entry.1219385526" },
  ],
};

const STATS_CONTENT = {
  rating: "4.8",
  label: "Excellent Choice",
  title: "Traveler Insights",
  description:
    "We take every piece of feedback seriously. Here is a breakdown of how our community perceives our services across key categories.",
};
---

<article
  class="flex flex-col  gap-12 lg:flex-row xl:max-w-7xl w-full mx-auto justify-between"
>

  <!-- Review Form Container (Smart Wrapper) -->
  <section
    class="relative border border-gray-200 rounded-sm p-6 md:p-12 overflow-hidden"
    aria-labelledby="form-title"
  >
    <!-- Success Panel: Displayed after successful submission -->
    <div
      id="success-panel"
      class="hidden flex mx-auto flex-col w-full items-center justify-center text-center py-12 space-y-6 animate-in fade-in zoom-in duration-500"
      role="alert"
    >
      <div
        class="w-20 h-20 bg-slate-900 rounded-full flex items-center justify-center shadow-lg"
      >
        <CheckIcon class="h-10 w-10 text-white" />
      </div>
      <div class="text-slate-950">
        <h3 class="text-3xl font-bold mb-2">{lenguaje.reviewForm.successTitle}</h3>
        <p class="max-w-sm font-medium">
          {lenguaje.reviewForm.successDescription}
        </p>
      </div>
      <button
        onclick="window.location.reload()"
        class="bg-slate-900 hover:bg-slate-800 text-white px-8 py-3 rounded-xl font-bold transition-all shadow-md active:scale-95"
      >
        {lenguaje.reviewForm.successButton}
      </button>
    </div>

    <!-- Form Panel -->
    <div id="form-panel">
      <header class="mb-4 text-center md:text-left">
        <h3 id="form-title" class="text-3xl font-bold text-slate-950 mb-3">
          {lenguaje.reviewForm.title}
        </h3>
        <p class="text-slate-900 font-medium max-w-xl">
          {lenguaje.reviewForm.description}
        </p>
      </header>

      <form
        id="google-review-form"
        class="space-y-4"
        data-action={FORM_CONFIG.actionUrl}
        data-entry-titulo={FORM_CONFIG.fields.tourTitle}
        data-sending={lenguaje.reviewForm.sending}
        data-error={lenguaje.reviewForm.errorAlert}
      >
        <!-- Ratings Grid (StarPicker components) -->
        <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
          {
            FORM_CONFIG.scores.map((score) => (
              <StarPicker label={score.label} entryId={score.entryId} />
            ))
          }
        </div>

        <!-- Contact Information -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
          <input
            type="text"
            name={FORM_CONFIG.fields.fullName}
            placeholder={lenguaje.reviewForm.placeholderName}
            aria-label="Full Name"
            class="w-full p-2 rounded-sm bg-white/60 border border-slate-900/20 text-slate-950 placeholder:text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900 transition-all font-medium"
          />
          <input
            type="email"
            name={FORM_CONFIG.fields.email}
            placeholder={lenguaje.reviewForm.placeholderEmail}
            aria-label="Email Address"
            class="w-full p-2 rounded-sm bg-white/60 border border-slate-900/20 text-slate-950 placeholder:text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900 transition-all font-medium"
          />
        </div>

        <!-- Feedback Message -->
        <textarea
          name={FORM_CONFIG.fields.message}
          rows="4"
          placeholder={lenguaje.reviewForm.placeholderMessage}
          aria-label="Your Feedback"
          class="w-full p-2 rounded-sm bg-white/60 border border-slate-900/20 text-slate-950 placeholder:text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900 transition-all resize-none font-medium"
        ></textarea>

        <!-- Form Footer/Action -->
        <footer
          class="flex flex-col md:flex-row items-center justify-between gap-6"
        >
          <p
            class="text-xs text-slate-950/70 font-bold max-w-sm text-center md:text-left"
          >
            {lenguaje.reviewForm.consent}
          </p>
          <button
            id="submit-btn"
            type="submit"
            class="w-full md:w-auto cursor-pointer border border-gray-200 duration-300 px-12 py-4 bg-slate-950 text-white rounded-sm font-black uppercase tracking-widest hover:bg-white hover:text-slate-950 active:bg-slate-950 active:text-white hover:scale-105 active:scale-95 transition-all shadow-xl "
          >
            {lenguaje.reviewForm.submit}
          </button>
        </footer>
      </form>
    </div>
  </section>
</article>

<script is:inline>
  function initRecomendaciones() {
    const form = document.querySelector("#google-review-form");
    const submitBtn = document.querySelector("#submit-btn");
    const formPanel = document.querySelector("#form-panel");
    const successPanel = document.querySelector("#success-panel");

    if (!form) return;

    // Remover listener anterior para evitar duplicados
    form.removeEventListener("submit", form._handleSubmit);

    form._handleSubmit = async (e) => {
      e.preventDefault();

      const actionUrl = form.dataset.action;

      // Update UI state
      submitBtn.disabled = true;
      const originalText = submitBtn.textContent;
      submitBtn.textContent = form.dataset.sending || "Sending...";
      submitBtn.classList.add("opacity-50", "cursor-not-allowed");

      const formData = new FormData(form);

      // Capturar el valor dinamico del titulo y adjuntarlo si existe
      const tituloEl = document.querySelector("#titulo");
      const entryTitulo = form.dataset.entryTitulo;
      if (tituloEl && tituloEl.dataset.titulo && entryTitulo) {
        formData.append(entryTitulo, tituloEl.dataset.titulo);
      }

      try {
        // Google Forms requires no-cors mode for cross-origin submission without a proper API
        await fetch(actionUrl, {
          method: "POST",
          mode: "no-cors",
          body: formData,
        });

        // Show success state
        formPanel.classList.add("hidden");
        successPanel.classList.remove("hidden");
        successPanel.scrollIntoView({
          behavior: "smooth",
          block: "center",
        });
      } catch (error) {
        console.error("Submission error:", error);
        alert(
          form.dataset.error || "There was an error sending your review. Please try again or contact us directly.",
        );

        // Reset UI state
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
        submitBtn.classList.remove("opacity-50", "cursor-not-allowed");
      }
    };

    form.addEventListener("submit", form._handleSubmit);

    // Resetear estado del form en cada navegación
    if (formPanel && successPanel) {
      formPanel.classList.remove("hidden");
      successPanel.classList.add("hidden");
    }
  }

  // Inicializar
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initRecomendaciones);
  } else {
    initRecomendaciones();
  }

  // Re-inicializar en cada navegación de ViewTransitions
  document.addEventListener("astro:page-load", () => {
    initRecomendaciones();
  });
</script>
