---
import PortadaStatic from "../../components/section/PortadaStatic.astro";
import Layout from "../../layouts/Layout.astro";
import Bento from "../../components/ui/Bento.astro";
import MainContent from "../../components/constructor/MainContent.astro";
import { getCollection, getEntry } from "astro:content";
import { getLocaleStaticPaths, getLocaleData, getPageCoverData } from "../../utils/getLocaleData";

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.params;
const { lang, lenguaje } = getLocaleData(locale);

const _menuData = (await getEntry("headerMenu", "menu"))!.data;
const { pageLabel: _pageLabel, coverImage: _coverImage } = getPageCoverData(_menuData.items, "AllToursPeru", lang);

const toursGlobalesEn = await getCollection("toursGlobalesEn");
const toursGlobalesEs = await getCollection("toursGlobalesEs");

const toursDestinos = [
  {
    title: "Perú",
    titleLink: "peru",
    url: "/images/machu.webp",
    destinosEN: toursGlobalesEn.map(({ data }) => data),
    destinosES: toursGlobalesEs.map(({ data }) => data),
  }
];
---

<Layout index={false} lenguaje={lenguaje}>
  <PortadaStatic
    url={_coverImage}
    texto={_pageLabel}
  />
  <MainContent>
    <Bento destinos={toursDestinos} />
  </MainContent>
</Layout>
